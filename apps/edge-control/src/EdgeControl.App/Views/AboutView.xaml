<UserControl x:Class="EdgeControl.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Segurança e sobre" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,22">
            <Run Text="Edge Control versão" />
            <Run Text="{Binding Version, Mode=OneWay}" />
        </TextBlock>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="O que este app faz no seu PC" Style="{StaticResource SectionTitle}" />
                <TextBlock Margin="0,0,0,6" Text="• Lê os relatórios de entrada do controle e o relatório de firmware (somente leitura). Nunca envia comandos de gravação ao controle." />
                <TextBlock Margin="0,0,0,6" Text="• Overclock: adiciona ou remove &quot;hidusbf&quot; da lista LowerFilters do controle e grava ou apaga o valor bInterval na chave do driver. São os mesmos dois valores que o Setup do hidusbf grava." />
                <TextBlock Margin="0,0,0,6" Text="• Antes de cada alteração salva um backup em C:\ProgramData\EdgeControl\backups. Se o controle não voltar em 15 segundos, restaura a configuração anterior sozinho." />
                <TextBlock Text="• Não instala, inicia nem altera o driver hidusbf, não mexe em Secure Boot, Test Mode ou Integridade de Memória e não atualiza firmware." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Riscos do overclock" Style="{StaticResource SectionTitle}" />
                <TextBlock Margin="0,0,0,6" Text="• A taxa de polling não altera tensão nem corrente do cabo USB. O risco físico ao controle é desprezível." />
                <TextBlock Margin="0,0,0,6" Text="• Taxas acima de 1000 Hz aumentam o uso de CPU e podem causar instabilidade em algumas controladoras USB. O controle pode parar de responder até ser reconectado." />
                <TextBlock Text="• Alguns jogos com anti-cheat bloqueiam drivers de filtro de terceiros. Se um jogo reclamar, use &quot;Restaurar padrão&quot;." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Créditos" Style="{StaticResource SectionTitle}" />
                <TextBlock Margin="0,0,0,6" Text="hidusbf é de SweetLow (binários de domínio público). A versão assinada é da Battle Beaver Customs. O driver não é distribuído com este app." />
                <TextBlock Text="Projeto independente, sem vínculo com a Sony Interactive Entertainment. DualSense e PlayStation são marcas da Sony Interactive Entertainment." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
