<UserControl x:Class="EdgeControl.App.Views.ControllerGraphic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Canvas Width="520" Height="320">
            <Canvas.Resources>
                <LinearGradientBrush x:Key="Shell" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F4F6FB" Offset="0" />
                    <GradientStop Color="#C9CFDE" Offset="1" />
                </LinearGradientBrush>
                <SolidColorBrush x:Key="Dark" Color="#1A1F2E" />
                <SolidColorBrush x:Key="Detail" Color="#2B3247" />
            </Canvas.Resources>

            <!-- Body -->
            <Path Fill="{StaticResource Shell}" Stroke="#8A93AD" StrokeThickness="1.5"
                  Data="M 150,40 C 200,24 320,24 370,40 L 400,42 C 440,44 462,74 472,112 L 500,236 C 510,284 484,310 452,304 C 426,299 410,276 394,250 L 372,214 L 148,214 L 126,250 C 110,276 94,299 68,304 C 36,310 10,284 20,236 L 48,112 C 58,74 80,44 120,42 Z" />
            <!-- Center dark plate with touchpad -->
            <Path Fill="{StaticResource Dark}"
                  Data="M 168,52 L 352,52 C 362,52 366,58 364,68 L 352,150 C 348,166 336,176 320,176 L 200,176 C 184,176 172,166 168,150 L 156,68 C 154,58 158,52 168,52 Z" />
            <Rectangle Canvas.Left="190" Canvas.Top="62" Width="140" Height="70" RadiusX="10" RadiusY="10" Fill="#232A3D" />
            <!-- Light bar accent -->
            <Rectangle Canvas.Left="200" Canvas.Top="136" Width="120" Height="3" RadiusX="2" RadiusY="2" Fill="{StaticResource Accent}" Opacity="0.85" />

            <!-- D-pad -->
            <Path Fill="{StaticResource Detail}" Data="M 92,92 h 16 v 18 h 18 v 16 h -18 v 18 h -16 v -18 h -18 v -16 h 18 z" />

            <!-- Face buttons -->
            <Ellipse Canvas.Left="404" Canvas.Top="76" Width="22" Height="22" Fill="{StaticResource Detail}" />
            <Ellipse Canvas.Left="430" Canvas.Top="100" Width="22" Height="22" Fill="{StaticResource Detail}" />
            <Ellipse Canvas.Left="404" Canvas.Top="124" Width="22" Height="22" Fill="{StaticResource Detail}" />
            <Ellipse Canvas.Left="378" Canvas.Top="100" Width="22" Height="22" Fill="{StaticResource Detail}" />

            <!-- Sticks -->
            <Ellipse Canvas.Left="160" Canvas.Top="170" Width="58" Height="58" Fill="{StaticResource Dark}" />
            <Ellipse Canvas.Left="170" Canvas.Top="180" Width="38" Height="38" Fill="{StaticResource Detail}" />
            <Ellipse Canvas.Left="302" Canvas.Top="170" Width="58" Height="58" Fill="{StaticResource Dark}" />
            <Ellipse Canvas.Left="312" Canvas.Top="180" Width="38" Height="38" Fill="{StaticResource Detail}" />

            <!-- Function buttons below the sticks -->
            <Rectangle Canvas.Left="222" Canvas.Top="222" Width="16" Height="8" RadiusX="4" RadiusY="4" Fill="{StaticResource Detail}" />
            <Rectangle Canvas.Left="282" Canvas.Top="222" Width="16" Height="8" RadiusX="4" RadiusY="4" Fill="{StaticResource Detail}" />
        </Canvas>
    </Viewbox>
</UserControl>
