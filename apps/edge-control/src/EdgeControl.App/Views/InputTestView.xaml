<UserControl x:Class="EdgeControl.App.Views.InputTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StickPad" TargetType="Border">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="120" />
            <Setter Property="CornerRadius" Value="60" />
            <Setter Property="Background" Value="{StaticResource CardHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="TriggerBar" TargetType="ProgressBar">
            <Setter Property="Maximum" Value="255" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Background" Value="{StaticResource CardHover}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Teste de entradas" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Mova os analógicos e pressione os botões. Use esta tela para conferir o controle depois de mudar a taxa."
                   Style="{StaticResource Muted}" Margin="0,0,0,22" />

        <WrapPanel>
            <Border Style="{StaticResource CardBorder}" Width="330">
                <StackPanel>
                    <TextBlock Text="Analógicos" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StickPad}">
                            <Canvas>
                                <Ellipse Width="16" Height="16" Fill="{StaticResource Accent}"
                                         Canvas.Left="{Binding LeftX}" Canvas.Top="{Binding LeftY}" />
                            </Canvas>
                        </Border>
                        <Border Style="{StaticResource StickPad}" Margin="40,0,0,0">
                            <Canvas>
                                <Ellipse Width="16" Height="16" Fill="{StaticResource Accent}"
                                         Canvas.Left="{Binding RightX}" Canvas.Top="{Binding RightY}" />
                            </Canvas>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Width="300">
                <StackPanel>
                    <TextBlock Text="Gatilhos" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="L2" Style="{StaticResource Muted}" />
                    <ProgressBar Style="{StaticResource TriggerBar}" Value="{Binding L2, Mode=OneWay}" Margin="0,4,0,14" />
                    <TextBlock Text="R2" Style="{StaticResource Muted}" />
                    <ProgressBar Style="{StaticResource TriggerBar}" Value="{Binding R2, Mode=OneWay}" Margin="0,4,0,14" />
                    <TextBlock Text="Taxa recebida" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Rate}" Style="{StaticResource Value}" />
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="Relatórios perdidos:" />
                        <Run Text="{Binding Dropped, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </WrapPanel>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Botões" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,8" Margin="0,0,8,8" CornerRadius="16" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardHover}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Pressed}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Accent}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Name}" FontSize="13" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Raw}" FontFamily="Consolas" Style="{StaticResource Muted}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
