<UserControl x:Class="EdgeControl.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Perfis" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Perfis personalizados do DualSense Edge." Style="{StaticResource Muted}" Margin="0,0,0,22" />

        <Border Style="{StaticResource CardBorder}" Padding="24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" Foreground="{StaticResource Warn}" />
                    <TextBlock Text="Em validação" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Margin="0,0,0,16"
                           Text="Esta seção fica bloqueada até que o protocolo usado pelo PlayStation Accessories seja analisado e cada comando de gravação seja confirmado. Gravar dados errados na memória do controle é o único ponto com risco real de deixá-lo inutilizável, por isso nada é enviado ao controle por enquanto." />
                <TextBlock Text="Previsto para esta seção:" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Planned}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
