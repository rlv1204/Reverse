<UserControl x:Class="EdgeControl.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:EdgeControl.App.Views">
    <StackPanel>
        <TextBlock Text="DualSense Edge" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Status do controle conectado por cabo." Style="{StaticResource Muted}" Margin="0,0,0,22" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="28">
                <Grid>
                    <v:ControllerGraphic MaxHeight="300" Margin="10">
                        <v:ControllerGraphic.Style>
                            <Style TargetType="v:ControllerGraphic">
                                <Setter Property="Opacity" Value="0.35" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </v:ControllerGraphic.Style>
                    </v:ControllerGraphic>
                    <TextBlock Text="Conecte o controle com o cabo USB" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Bateria" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Battery}" Style="{StaticResource Value}" />
                        <ProgressBar Value="{Binding BatteryPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,10,0,0"
                                     Foreground="{StaticResource Ok}" Background="{StaticResource CardHover}" BorderThickness="0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Taxa de polling" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding MeasuredRate}" Style="{StaticResource Value}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                            <Run Text="Configurada:" />
                            <Run Text="{Binding ConfiguredRate, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Firmware (somente leitura)" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Firmware}" Style="{StaticResource Value}" FontSize="15" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                            <Run Text="Hardware:" />
                            <Run Text="{Binding Hardware, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text="Compilação:" />
                            <Run Text="{Binding BuildDate, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
