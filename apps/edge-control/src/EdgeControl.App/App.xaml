<Application x:Class="EdgeControl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EdgeControl.App.ViewModels"
             xmlns:v="clr-namespace:EdgeControl.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette: dark navy surfaces with a blue accent. -->
            <Color x:Key="BgColor">#0B0F1C</Color>
            <Color x:Key="SidebarColor">#0F1426</Color>
            <Color x:Key="CardColor">#161C33</Color>
            <Color x:Key="CardHoverColor">#1E2644</Color>
            <Color x:Key="BorderColor">#26304F</Color>
            <Color x:Key="AccentColor">#3D7BFF</Color>
            <Color x:Key="TextColor">#F2F4FA</Color>
            <Color x:Key="MutedColor">#9AA3BF</Color>
            <Color x:Key="OkColor">#3DD68C</Color>
            <Color x:Key="WarnColor">#FFB547</Color>
            <Color x:Key="DangerColor">#FF5C6C</Color>

            <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="Sidebar" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardHover" Color="{StaticResource CardHoverColor}" />
            <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}" />
            <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
            <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Card}" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Margin" Value="0,0,12,12" />
            </Style>

            <Style x:Key="Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Sidebar navigation entry. -->
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="10" Padding="14,11" Margin="10,2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Card}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource CardHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ButtonBase" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="Background" Value="{StaticResource CardHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="22" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}" />

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource Card}" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            </Style>

            <!-- Page view selection by view model type. -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <v:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InputTestViewModel}">
                <v:InputTestView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
                <v:ProfilesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OverclockViewModel}">
                <v:OverclockView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <v:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
