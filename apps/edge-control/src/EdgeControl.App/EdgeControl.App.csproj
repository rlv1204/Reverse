  <ItemGroup>
    <ProjectReference Include="..\EdgeControl.Core\EdgeControl.Core.csproj" />
    <ProjectReference Include="..\EdgeControl.Windows\EdgeControl.Windows.csproj" />
  </ItemGroup>
</Project>
